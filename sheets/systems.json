{
  "sheet": "systems",
  "description": "Every system the HKIA Island Explorer exe touches. Each row generates one piece of code in source/hkia-island-explorer.cs.",
  "columns": ["id", "system", "hook", "readsFromHKIA", "writesToLog", "testMarker", "inMvp"],
  "rows": [
    { "id": "hkia_path", "system": "Accept HKIA install path from Melty launch argument", "hook": "exe startup (Main)", "readsFromHKIA": "{game:custom-hello-kitty-island-adventure} passed as -gamepath", "writesToLog": false, "chatAnnouncement": false, "testMarker": false, "inMvp": true },
    { "id": "scan_entities", "system": "Scan HKIA StreamingAssets/EntityScenes/*.entities for region and item tokens", "hook": "exe startup", "readsFromHKIA": "entity files under {game}/Hello Kitty_Data/StreamingAssets/EntityScenes", "writesToLog": false, "chatAnnouncement": false, "testMarker": false, "inMvp": true },
    { "id": "scan_music", "system": "Scan HKIA StreamingAssets/MX_Score_*.bank for music tracks", "hook": "exe startup", "readsFromHKIA": "music banks under {game}/Hello Kitty_Data/StreamingAssets", "writesToLog": false, "chatAnnouncement": false, "testMarker": false, "inMvp": true },
    { "id": "display_content", "system": "Print discovered regions, items, and music to console", "hook": "exe startup", "readsFromHKIA": "scanned HKIA content", "writesToLog": true, "chatAnnouncement": false, "testMarker": false, "inMvp": true },
    { "id": "test_marker", "system": "Write test marker so Melty's test confirms the mod played, not only started", "hook": "exe startup", "readsFromHKIA": false, "writesToLog": "{localappdata}/island-outbreak/melty.log: MELTY_TEST_ISLAND_ACTIVE:1", "chatAnnouncement": false, "testMarker": true, "inMvp": true }
  ]
}
